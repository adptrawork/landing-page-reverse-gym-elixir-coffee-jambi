---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, coaches, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau konsultasi program.`);
---
<!-- Ref: Unbounce fitness — head (hook) + content + CTA -->
<BaseLayout title="Kenalan dengan coach — Reverse Gym Jambi" description="REVERSE Medical & Family Gym — Recovery • Performance • Longevity, Fatloss Specialist,   // Personalized program by experts" canonicalPath="/Pelatih" image={business.ogImage}>
  <section class="bg-stone-900 text-white" aria-labelledby="subhead">
    <div class="max-w-7xl mx-auto px-4 pt-14 pb-12 md:pt-20 md:pb-16">
      <nav class="font-mono-num text-xs uppercase tracking-[0.18em] text-white/60" aria-label="Breadcrumb"><a href="/" class="hover:text-white">Beranda</a> / Pelatih & instruktur</nav>
      <h1 id="subhead" class="mt-3 max-w-[20ch] text-3xl md:text-5xl font-black uppercase tracking-tighter">Kenalan dengan coach</h1>
      <p class="mt-3 max-w-[60ch] text-base text-white/75">Coach & instruktur yang mendampingi tiap sesi latihanmu.</p>
      <a href={heroCta} class="mt-6 inline-flex min-h-[48px] items-center rounded-full bg-teal-800 px-7 text-sm font-black uppercase tracking-wide text-white transition hover:opacity-90">Konsultasi Fatloss</a>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20" aria-label="Daftar pelatih">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {coaches.map((c) => (
        <article class="rounded-3xl border border-stone-200 bg-white p-6">
          <div class="grid h-14 w-14 place-items-center rounded-2xl bg-teal-800 font-mono-num text-lg font-bold text-white" aria-hidden="true">{c.role.slice(0, 1)}</div>
          <p class="mt-4 font-mono-num text-[11px] font-bold uppercase tracking-[0.18em] text-teal-800">{c.badge}</p>
          <h2 class="mt-1 text-lg font-extrabold tracking-tight">{c.role}</h2>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">{c.desc}</p>
          <a href={heroCta} class="mt-4 inline-flex min-h-[48px] items-center justify-center rounded-full border border-teal-800 px-5 text-sm font-bold uppercase tracking-wide text-teal-800 transition hover:bg-teal-800 hover:text-white">Tanya Coach</a>
        </article>
      ))}
    </div>
    <p class="mt-4 text-xs text-stone-500">Nama coach aktual dapat berubah — konfirmasi via kontak resmi sebelum datang.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 pb-12 md:pb-20" aria-label="Ajakan">
    <div class="rounded-3xl bg-stone-900 p-8 text-white md:p-10">
      <p class="text-2xl font-black uppercase tracking-tight">Mau didampingi dari nol?</p>
      <p class="mt-2 text-sm text-white/70">Ceritakan tujuanmu — coach bantu susun langkah pertama.</p>
      <a href={heroCta} class="mt-5 inline-flex min-h-[48px] items-center rounded-full bg-white px-8 text-sm font-black uppercase tracking-wide text-stone-900">Konsultasi Fatloss</a>
    </div>
  </section>
</BaseLayout>
