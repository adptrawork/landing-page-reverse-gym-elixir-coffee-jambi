---
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  image?: string;
}
const { title, description, canonicalUrl, image = '/images/reverse-1.jpg' } = Astro.props;
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Apa itu Reverse Medical & Family Gym di Jambi?",
      acceptedAnswer: { "@type": "Answer", text: "Reverse adalah medical & family gym dengan tiga pilar Recovery, Performance, dan Longevity. Layanan terverifikasi dari IG resmi @reverse.fitnessindonesia meliputi InBody check, fatloss specialist, personalized program, dan physio." }
    },
    {
      "@type": "Question",
      name: "Di mana lokasi Elixir Coffee dan jam bukanya?",
      acceptedAnswer: { "@type": "Answer", text: "Elixir Coffee di Jl. Nias, Kota Baru, Jambi. Buka weekday 06.00–22.00 dan weekend 06.00–23.00, tersedia juga di GrabFood." }
    },
    {
      "@type": "Question",
      name: "Bagaimana cara konsultasi program fatloss di Reverse Gym?",
      acceptedAnswer: { "@type": "Answer", text: "Konsultasi via WhatsApp 0813-7000-780 (tombol WA dari bio IG resmi). Diawali InBody check lalu disusun personalized program oleh coach dan physio." }
    }
  ]
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@500;700&family=Geist+Mono:wght@500&display=swap" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@500;700&family=Geist+Mono:wght@500&display=swap" /></noscript>
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content="Reverse Gym & Elixir Coffee — Recovery, Performance, Longevity" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="Training center Reverse Gym dan interior Elixir Coffee Jambi" />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ExerciseGym",
  name: "Reverse Gym & Elixir Coffee",
  url: "https://reverse-elixir-jambi.pages.dev",
  image: ogImage,
  description: description,
  exerciseType: ["Physiotherapy", "Nutrition"],
  address: { "@type": "PostalAddress", streetAddress: "Jl. Nias, Kota Baru", addressLocality: "Kota Jambi", addressRegion: "Jambi", addressCountry: "ID" },
  sameAs: ["https://www.instagram.com/reverse.fitnessindonesia", "https://www.instagram.com/elixir.coffeexperience"]
})} />
<script type="application/ld+json" set:html={JSON.stringify(faq)} />
