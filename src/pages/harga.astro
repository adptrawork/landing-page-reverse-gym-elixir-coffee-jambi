---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, prices, waLink } from '../data/business';
---
<BaseLayout title={`Harga ${business.name} — InBody, PT & Member`} description={`Harga Reverse Gym Jambi: angka estimasi, konfirmasi via WA 0813-7000-780. InBody & program fatloss konsultasi dulu.`} canonicalPath="/harga">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="text-sm font-medium text-amber-600">Harga</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Investasi sesuai target badan</h1>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Semua angka <strong>Estimasi</strong> — price list resmi hanya via WA 0813-7000-780 (tombol bio IG). Jangan transfer sebelum konfirmasi.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
          <img src="/images/reverse-4.jpg" alt="Area pemulihan dan physio Reverse Gym Jambi" width="800" height="600" loading="eager" class="w-full aspect-[4/3] object-cover" />
          <p class="p-5 text-sm text-gray-600">Termasuk akses recovery — foto konteks, ganti foto asli. Sumber: Unsplash (bebas lisensi).</p>
        </div>
      </div>
    </div>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {prices.map((p, i) => (
        <article class={i % 2 === 1 ? 'md:mt-10' : ''}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <p class="text-xs font-medium text-amber-600">{p.badge}</p>
            <h2 class="mt-1 font-semibold text-lg tracking-tight">{p.name}</h2>
            <p class="mt-1 text-sm text-gray-600">{p.desc}</p>
          </div>
          <div class="mt-3 flex items-center justify-between px-2">
            <p class="font-mono-num font-semibold">{p.price}</p>
            <a href={waLink(`Halo ${business.name}, saya mau tanya ${p.name} (${p.price}). Apakah masih berlaku?`)} class="bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm font-medium">Konfirmasi via WA</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
