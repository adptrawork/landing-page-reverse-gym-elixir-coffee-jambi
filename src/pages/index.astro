---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import MapFacade from '../components/MapFacade.astro';
import { business, programs, waLink } from '../data/business';

const waGym = waLink('Halo Reverse Gym & Elixir Coffee, saya mau tanya program gym dan InBody check.');
const waCoffee = waLink('Halo Elixir Coffee, saya mau tanya menu dan jam buka.');
const waUmum = waLink('Halo Reverse Gym & Elixir Coffee, saya mau tanya keanggotaan dan tarif.');

// Layanan inti gym (zig-zag) & entri kafe (papan menu) — hanya dari business.ts.
const gymPrograms = programs.slice(0, 4);
const cafeEntries = programs.slice(4, 6);

// Hero duality: pilar dari bio IG resmi (gym) & jam Elixir (kafe) — data terverifikasi.
const gymWords = ['Recovery', 'Performance', 'Longevity'];
const cafeMeta = ['Weekday 06.00–22.00', 'Weekend 06.00–23.00', 'Dine-in & GrabFood'];

const alur = [
  {
    n: '01',
    t: 'Konsultasi & asesmen',
    d: 'Ceritakan tujuanmu, lalu mulai dari InBody check untuk membaca komposisi tubuh. InBody dan physio tercatat di sorotan IG resmi @reverse.fitnessindonesia.',
  },
  {
    n: '02',
    t: 'Susun program & pilih keanggotaan',
    d: 'Personalized program by experts disusun dari hasil asesmen. Tarif paket dan durasi dikonfirmasi via WhatsApp — harga di situs ini berlabel estimasi.',
  },
  {
    n: '03',
    t: 'Latihan, pulihkan, lalu ngopi',
    d: 'Latihan di training center, pendampingan pilar recovery, lalu jeda di Elixir Coffee. Gym dan kafe berada di satu lokasi, tanpa pindah tempat.',
  },
];

const fasilitas = [
  { t: 'InBody', d: 'Pengukuran komposisi tubuh sebelum program disusun.', b: 'Terverifikasi' },
  { t: 'Physio', d: 'Pendampingan pemulihan untuk keluhan nyeri atau cedera.', b: 'Terverifikasi' },
  { t: 'Training center', d: 'Area latihan beban dan kardio untuk sesi harian.', b: 'Terverifikasi' },
  { t: 'Coach', d: 'Pendampingan personal sesuai tujuan dan kondisi.', b: 'Terverifikasi' },
  { t: 'EnglishClub', d: 'Kegiatan tambahan yang tampil di sorotan IG resmi; jadwal via WhatsApp.', b: 'Terverifikasi' },
];

const jam = [
  { k: 'Elixir Coffee — weekday', v: '06.00–22.00', b: 'Terverifikasi IG' },
  { k: 'Elixir Coffee — weekend', v: '06.00–23.00', b: 'Terverifikasi IG' },
  { k: 'InBody & physio', v: 'Jadwal: konfirmasi via WA', b: 'Terverifikasi IG' },
  { k: 'Pemesanan Elixir', v: 'Dine-in & GrabFood', b: 'Terverifikasi IG' },
];
---
<!-- Ref: duality editorial dark earthy — kolase asimetris + dua panel identitas -->
<BaseLayout
  title="Reverse Gym & Elixir Coffee Jambi — Gym & Kopi Satu Atap"
  description="Medical & family gym Jambi: InBody check, fatloss specialist, physio, plus Elixir Coffee di satu lokasi Jl. Nias. Konsultasi program via WhatsApp 0813-7000-780."
  canonicalPath="/"
  image={business.ogImage}
>

  <!-- Ref: duality split hero — gym (gelap, berat, grid weight-room) vs coffee bar (hangat, terang, motif cangkir/uap), garis seam + lencana melingkar berputar -->
  <!-- 01 HERO — split dua karakter: kiri gym, kanan kopi -->
  <section class="duality border-b b-rule" aria-labelledby="hero">
    <!-- KIRI — sisi GYM: foto gelap + grid weight-room + tipografi berat -->
    <div class="duality__gym">
      <img class="duality__bg" src="/images/reverse-1.webp" alt="" width="800" height="533" fetchpriority="high" decoding="async" />
      <div class="duality__scrim" aria-hidden="true"></div>

      <div class="duality__pad">
        <p class="eyebrow rise" style="--i:0">
          <span class="num">01</span>
          <span class="duality__tick" aria-hidden="true"></span>
          Reverse &mdash; sisi gym
        </p>
        <h1 id="hero" class="duality__display rise mt-5" style="--i:1">
          Latihan yang<br />serius.
        </h1>
        <p class="duality__lead rise" style="--i:2">
          Medical &amp; family gym: fatloss specialist, InBody check, physio, dan personalized
          program by experts &mdash; disusun dari hasil asesmen, bukan resep massal.
        </p>
        <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href={waGym} class="btn btn-solid" target="_blank" rel="noopener">Mulai dari sisi gym</a>
          <a href="#kopi" class="btn btn-ghost">Kenali sisi kopi</a>
        </div>
        <ul class="rowlist duality__facts rise mt-10" style="--i:4" aria-label="Tiga pilar Reverse Gym">
          {gymWords.map((w) => (
            <li class="duality__fact">
              <span class="duality__dot" aria-hidden="true"></span>
              <span class="text-sm font-semibold uppercase tracking-[0.14em]">{w}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Lencana melingkar di seam (dekoratif) -->
      <div class="seam-badge" aria-hidden="true">
        <svg class="seam-badge__ring" viewBox="0 0 100 100">
          <defs>
            <path id="seam-circle" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" />
          </defs>
          <text class="seam-badge__text">
            <textPath href="#seam-circle">REVERSE GYM &#8226; ELIXIR COFFEE &#8226; JL. NIAS &#8226; KOTA JAMBI &#8226;</textPath>
          </text>
        </svg>
        <span class="seam-badge__core">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M4 9v6M7.5 7v10M16.5 7v10M20 9v6M7.5 12h9" stroke-linecap="round" />
          </svg>
        </span>
      </div>
    </div>

    <!-- KANAN — sisi KOPI: panel hangat terang + motif cangkir/uap -->
    <div class="duality__coffee">
      <svg class="duality__cup" viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
        <path d="M58 82h108v40a42 42 0 0 1-42 42h-24a42 42 0 0 1-42-42V82Z" stroke-linejoin="round" />
        <path d="M166 94h12a22 22 0 0 1 0 44h-14" stroke-linecap="round" />
        <path d="M92 58c0-12 8-12 8-26M118 58c0-12 8-12 8-26M144 58c0-12 8-12 8-26" stroke-linecap="round" />
      </svg>

      <div class="duality__pad">
        <p class="eyebrow on-latte rise" style="--i:0">
          <span class="num">02</span>
          <span class="duality__tick on-latte" aria-hidden="true"></span>
          Elixir &mdash; sisi kopi
        </p>
        <h2 class="duality__display duality__display--coffee rise mt-5" style="--i:1">
          Kopi yang<br />tenang.
        </h2>
        <p class="duality__lead on-latte rise" style="--i:2">
          Jeda setelah sesi: kopi, opsi makan sehat, dan tempat duduk yang tenang.
          Dine-in atau pesan antar &mdash; tanpa pindah tempat dari training center.
        </p>
        <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href={waCoffee} class="btn btn-fg" target="_blank" rel="noopener">Tanya menu Elixir</a>
          <a href={business.elixirInstagram} class="btn btn-line" target="_blank" rel="noopener">IG Elixir</a>
        </div>
        <ul class="rowlist duality__facts rise mt-10" style="--i:4" aria-label="Info Elixir Coffee">
          {cafeMeta.map((m) => (
            <li class="duality__fact">
              <span class="duality__dot on-latte" aria-hidden="true"></span>
              <span class="on-latte text-sm font-semibold uppercase tracking-[0.14em]">{m}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Catatan label data (bisnis) di bawah split -->
    <p class="duality__note rise" style="--i:5">
      Label <strong class="font-semibold text-sage">Terverifikasi</strong> berarti bersumber dari bio/highlight IG resmi.
      Harga <strong class="font-semibold text-sage">Estimasi</strong> dikonfirmasi via WhatsApp sebelum membayar.
    </p>
  </section>

  <!-- 02 DUA PANEL IDENTITAS — split asimetris 1.15fr / .85fr dengan rule -->
  <section class="border-b b-rule py-14 md:py-24" aria-labelledby="identitas">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <SectionHead
        id="identitas"
        index="02"
        eyebrow="Satu lokasi, dua karakter"
        title="Gym yang mengukur, kafe yang menenangkan"
        lead="Dua wajah dari alamat yang sama di Jl. Nias, Kota Baru. Pilih sisi mana yang kamu butuhkan lebih dulu — keduanya bisa dalam satu kunjungan."
      />

      <div class="duo mt-12">
        <div class="duo__left">
          <p class="eyebrow">Reverse &mdash; sisi latihan</p>
          <h3 class="font-display mt-3 text-[clamp(1.6rem,3.4vw,2.4rem)] leading-tight">Recovery, performance, longevity</h3>
          <p class="mt-4 max-w-[48ch] text-sm text-soft">
            Medical &amp; family gym dengan spesialisasi fatloss. Program disusun personal dari hasil asesmen,
            bukan kelas massal dengan satu resep untuk semua.
          </p>
          <ul class="rowlist mt-8 border-t b-rule">
            {gymPrograms.map((p, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] items-baseline gap-4 py-4">
                <span class="num font-display text-lg text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-sm font-semibold">{p.name}</span>
              </li>
            ))}
          </ul>
          <a href="/program" class="btn btn-ghost mt-8 w-full sm:w-auto">Lihat semua program</a>
        </div>

        <div class="duo__right mt-12 md:mt-0">
          <figure class="frame aspect-[16/9] rounded-sm border b-rule">
            <img src="/images/reverse-5.webp" alt="Ruang kafe Elixir Coffee Kota Baru Jambi" width="720" height="494" loading="lazy" decoding="async" />
          </figure>
          <p class="on-bg-2 eyebrow mt-6">Elixir &mdash; sisi kopi</p>
          <h3 class="font-display mt-3 text-[clamp(1.6rem,3.4vw,2.4rem)] leading-tight">Kopi, makanan, dan jeda</h3>
          <p class="on-bg-2 mt-4 max-w-[44ch] text-sm">
            Setelah sesi, tinggal menyeberang: kopi, opsi makan sehat, dan tempat duduk yang tenang.
            Tersedia untuk dine-in maupun pesan antar.
          </p>
          <ul class="rowlist mt-8 border-t b-rule">
            {cafeEntries.map((p) => (
              <li class="grid grid-cols-[1fr_auto] items-baseline gap-4 py-4">
                <span class="text-sm font-semibold">{p.name}</span>
                <span class="on-bg-2 text-[11px] font-semibold uppercase tracking-[0.16em]">{p.badge}</span>
              </li>
            ))}
          </ul>
          <a href="#kopi" class="btn btn-ghost mt-8 w-full">Menu kafe</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 ALUR TIGA TAHAP — list bernomor ber-rule -->
  <section class="border-b b-rule py-14 md:py-24" aria-labelledby="alur">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <SectionHead
        id="alur"
        index="03"
        eyebrow="Alur bergabung"
        title="Tiga tahap, dari konsultasi sampai ngopi"
        lead="Tidak ada langkah yang dipaksakan. Setiap tahap dikonfirmasi lewat WhatsApp resmi 0813-7000-780."
      />
      <ol class="rowlist mt-12 border-t b-rule">
        {alur.map((s, i) => (
          <li class="step rise" style={`--i:${i + 1}`}>
            <span class="num font-display text-4xl leading-none text-accent" aria-hidden="true">{s.n}</span>
            <h3 class="font-display text-2xl leading-snug">{s.t}</h3>
            <p class="max-w-[52ch] text-sm text-soft">{s.d}</p>
          </li>
        ))}
      </ol>
      <a href={waUmum} class="btn btn-solid mt-10 w-full sm:w-auto" target="_blank" rel="noopener">Tanya keanggotaan</a>
    </div>
  </section>

  <!-- 04 PROGRAM GYM — zig-zag 2 kolom + daftar jam ber-rule -->
  <section class="border-b b-rule py-14 md:py-24" aria-labelledby="program">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <SectionHead
        id="program"
        index="04"
        eyebrow="Program & jam"
        title="Empat layanan inti di sisi gym"
        lead="Setiap nama di bawah ini berasal dari bio atau sorotan IG resmi. Detail jadwal dan tarif dikonfirmasi via WhatsApp."
      />

      <div class="mt-14 grid gap-14 md:gap-20">
        {gymPrograms.map((p, i) => (
          <article class="zig">
            <figure class:list={['frame aspect-[4/3] rounded-sm border b-rule', i % 2 === 1 && 'md:order-2']}>
              <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" decoding="async" />
            </figure>
            <div class:list={[i % 2 === 1 && 'md:order-1']}>
              <p class="eyebrow flex items-center gap-3">
                <span class="num text-accent">{String(i + 1).padStart(2, '0')}</span>
                <span>{p.badge}</span>
              </p>
              <h3 class="font-display mt-3 text-[clamp(1.5rem,3vw,2.2rem)] leading-tight">{p.name}</h3>
              <p class="mt-3 max-w-[48ch] text-sm text-soft">{p.desc}</p>
              <a href={waGym} class="btn btn-ghost mt-6" target="_blank" rel="noopener">Tanya layanan ini</a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-4">
          <h3 class="eyebrow">Jam &amp; akses</h3>
          <p class="mt-3 max-w-[38ch] text-sm text-soft">
            Jam Elixir Coffee tercatat di IG resmi. Jam gym dan sesi InBody/physio belum dipublikasikan —
            tanyakan langsung agar tidak salah datang.
          </p>
        </div>
        <ul class="rowlist md:col-span-8">
          {jam.map((j) => (
            <li class="grid grid-cols-[1fr_auto] items-baseline gap-4 border-t b-rule py-4 md:grid-cols-[1fr_auto_10rem]">
              <span class="text-sm">{j.k}</span>
              <span class="num text-sm font-semibold text-accent">{j.v}</span>
              <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-soft md:text-right">{j.b}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 05 MENU KAFE — daftar dua kolom bergaya menu kafe (nama + leader + harga) -->
  <section id="kopi" class="border-b b-rule bg-bg-2 py-14 md:py-24" aria-labelledby="menu">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <header class="grid grid-cols-1 gap-5 md:grid-cols-12 md:items-end md:gap-8">
        <div class="md:col-span-7">
          <p class="eyebrow flex items-center gap-3">
            <span class="num text-accent">05</span>
            <span>Elixir Coffee</span>
            <span class="hidden h-px w-16 shrink-0 bg-sage/40 sm:block" aria-hidden="true"></span>
          </p>
          <h2 id="menu" class="font-display mt-3 text-[clamp(1.9rem,4.6vw,3.15rem)] leading-[1.06]">Papan menu kafe</h2>
        </div>
        <p class="on-bg-2 max-w-[46ch] text-sm md:col-span-5">
          Dua kategori yang tercatat di data resmi. Daftar menu lengkap dan harga aktual ada di IG
          @elixir.coffeexperience dan GrabFood.
        </p>
      </header>

      <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <h3 class="on-bg-2 eyebrow">Kopi &amp; minuman</h3>
          <ul class="rowlist mt-4 border-t b-rule">
            <li class="flex items-baseline py-4">
              <span class="text-base">Kopi &amp; nongkrong di Elixir</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="text-sm font-semibold text-sage">Cek IG</span>
            </li>
            <li class="flex items-baseline py-4">
              <span class="text-base">Latte art &amp; kopi susu</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="text-sm font-semibold text-sage">Cek GrabFood</span>
            </li>
            <li class="flex items-baseline py-4">
              <span class="text-base">Jam buka weekday</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="num text-sm font-semibold text-fg">06.00–22.00</span>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="on-bg-2 eyebrow">Makanan &amp; pendamping latihan</h3>
          <ul class="rowlist mt-4 border-t b-rule">
            <li class="flex items-baseline py-4">
              <span class="text-base">Protein bar &amp; makan sehat</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="text-sm font-semibold text-sage">Konfirmasi WA</span>
            </li>
            <li class="flex items-baseline py-4">
              <span class="text-base">Menu pendamping setelah latihan</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="text-sm font-semibold text-sage">Cek IG</span>
            </li>
            <li class="flex items-baseline py-4">
              <span class="text-base">Jam buka weekend</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="num text-sm font-semibold text-fg">06.00–23.00</span>
            </li>
          </ul>
        </div>
      </div>

      <p class="on-bg-2 mt-10 max-w-[70ch] text-xs">
        Harga menu belum dipublikasikan pada sumber data yang tersedia, jadi sengaja tidak dicantumkan di sini.
        Label <strong class="font-semibold text-fg">Estimasi</strong> pada data bisnis menandakan perlu konfirmasi.
      </p>
      <a href={waCoffee} class="btn btn-fg mt-6 w-full sm:w-auto" target="_blank" rel="noopener">Tanya menu Elixir</a>
    </div>
  </section>

  <!-- 06 FASILITAS TAMBAHAN — list ber-rule -->
  <section class="border-b b-rule py-14 md:py-24" aria-labelledby="fasilitas">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <SectionHead
        id="fasilitas"
        index="06"
        eyebrow="Fasilitas & layanan"
        title="Yang tersedia di sorotan resmi"
        lead="Daftar ini mengikuti sorotan (highlight) IG @reverse.fitnessindonesia — bukan klaim tambahan dari kami."
      />
      <ul class="rowlist mt-12 border-t b-rule">
        {fasilitas.map((f, i) => (
          <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 border-b b-rule py-5 md:grid-cols-[14rem_1fr_9rem]">
            <h3 class="font-display text-xl leading-none">{f.t}</h3>
            <p class="text-sm text-soft">{f.d}</p>
            <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sage md:text-right">{f.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 07 LOKASI & JAM + MapFacade + CTA WhatsApp -->
  <section class="py-14 md:py-24" aria-labelledby="lokasi">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <SectionHead
        id="lokasi"
        index="07"
        eyebrow="Lokasi & jam"
        title="Satu alamat di Jl. Nias, Kota Baru"
        lead="Alamat gym dan kafe sama. Peta dimuat hanya setelah kamu klik, supaya halaman tetap ringan."
      />
      <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-4">
          <dl class="rowlist border-t b-rule">
            <div class="py-4">
              <dt class="eyebrow">Alamat</dt>
              <dd class="mt-2 text-sm">{business.address}</dd>
            </div>
            <div class="py-4">
              <dt class="eyebrow">Jam</dt>
              <dd class="mt-2 text-sm">{business.hours}</dd>
            </div>
            <div class="py-4">
              <dt class="eyebrow">WhatsApp</dt>
              <dd class="mt-2 text-sm">0813-7000-780</dd>
            </div>
          </dl>
          <div class="mt-8 grid gap-3">
            <a href={waUmum} class="btn btn-solid w-full" target="_blank" rel="noopener">Konsultasi via WhatsApp</a>
            <a href={business.mapsUrl} class="btn btn-ghost w-full" target="_blank" rel="noopener">Buka rute Google Maps</a>
          </div>
        </div>
        <div class="md:col-span-8">
          <MapFacade src={business.mapsEmbed} title="Peta lokasi Reverse Gym & Elixir Coffee, Jl. Nias Kota Baru Jambi" mapsUrl={business.mapsUrl} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
