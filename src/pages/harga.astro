---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, prices, waLink } from '../data/business';
---
<BaseLayout title="Harga Reverse Gym Jambi — InBody, Member & Paket Fatloss" description="Harga Reverse Gym: InBody check, harian, bulanan, personal training, paket fatloss 12 minggu. Estimasi — konsultasi tarif via WA 0813-7000-780." canonicalPath="/harga">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800">Harga</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Investasi yang terukur</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Semua angka <strong>Estimasi</strong> kecuali dinyatakan lain — konsultasi tarif via WA <strong>0813-7000-780</strong>.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-teal-800 text-stone-50 rounded-[2.5rem] p-8">
          <p class="font-mono-num text-xs text-teal-200">REKOMENDASI AWAL</p>
          <p class="mt-2 font-bold text-xl tracking-tight">InBody Check + Konsultasi</p>
          <p class="mt-1 text-sm text-stone-200/85">Mulai dari data tubuh, bukan tebakan.</p>
          <a href={waLink('Halo Reverse Gym, saya mau InBody check + konsultasi.')} class="mt-4 inline-block bg-stone-50 text-teal-900 px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Jadwalkan via WA</a>
        </div>
      </div>
    </div>
    <ol class="mt-10 bg-white border border-stone-200/70 rounded-[2.5rem] divide-y divide-stone-200/80 px-7 md:px-9">
      {prices.map((p, i) => (
        <li class="flex flex-col md:flex-row md:items-center gap-3 md:gap-6 py-6">
          <span class="font-mono-num text-xs text-teal-800 w-7 shrink-0">0{i + 1}</span>
          <div class="flex-1">
            <h2 class="font-bold text-lg tracking-tight">{p.name}</h2>
            <p class="mt-0.5 text-sm text-stone-600">{p.desc} <span class="font-mono-num text-xs text-stone-400">[{p.badge}]</span></p>
          </div>
          <p class="font-mono-num font-semibold whitespace-nowrap">{p.price}</p>
          <a href={waLink(`Halo ${business.name}, saya mau tanya ${p.name} (${p.price}).`)} class="shrink-0 bg-stone-900 text-white px-5 py-2.5 rounded-full text-sm text-center active:scale-[0.98]">Tanya via WA</a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
