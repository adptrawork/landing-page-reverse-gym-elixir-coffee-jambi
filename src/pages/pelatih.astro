---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, coaches, waLink } from '../data/business';
---
<BaseLayout title="Pelatih Reverse Gym Jambi — Coach Fatloss & Physio" description="Tim Reverse Gym: coach fatloss & performance, physio recovery, coach training center. Terverifikasi highlight IG @reverse.fitnessindonesia." canonicalPath="/pelatih">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800">Pelatih</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Dibimbing ahli, bukan tebakan</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Peran terverifikasi dari highlight IG resmi. Keluhan cedera/nyeri — konsultasi dulu via WA.</p>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden">
          <img src="/images/reverse-3.jpg" alt="Coach Reverse Gym mendampingi program fatloss member" width="800" height="600" loading="eager" class="w-full aspect-[4/3] object-cover" />
          <p class="p-5 text-sm text-stone-600">Sesi coaching — foto konteks (Unsplash). Ganti foto asli.</p>
        </div>
      </div>
    </div>
    <ol class="mt-10 bg-white border border-stone-200/70 rounded-[2.5rem] divide-y divide-stone-200/80 px-7 md:px-9">
      {coaches.map((c, i) => (
        <li class="flex items-start gap-5 py-6">
          <span class="font-mono-num font-semibold text-teal-800 border border-teal-800/30 rounded-2xl w-11 h-11 grid place-items-center shrink-0">0{i + 1}</span>
          <div class="flex-1">
            <p class="font-mono-num text-xs text-teal-800">{c.badge}</p>
            <p class="mt-1 font-bold text-lg tracking-tight">{c.role}</p>
            <p class="mt-1 text-base text-stone-600">{c.desc}</p>
          </div>
          <a href={waLink(`Halo ${business.name}, saya mau konsultasi dengan ${c.role}.`)} class="hidden md:inline-block shrink-0 bg-teal-800 text-white px-5 py-2.5 rounded-full text-sm active:scale-[0.98]">Tanya via WA</a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
