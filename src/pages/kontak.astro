---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import MapFacade from '../components/MapFacade.astro';
import { business, waLink } from '../data/business';

const waKontak = waLink('Halo Reverse Gym & Elixir Coffee, saya mau tanya program dan jadwal.');
const waKonsult = waLink('Halo Reverse Gym, saya mau konsultasi program fatloss.');
---
<!-- Ref: duality editorial dark earthy — kontak: NAP + jam + MapFacade + CTA WA -->
<BaseLayout
  title="Hubungi & Kunjungi — Reverse Gym & Elixir Coffee Jambi"
  description="Kontak resmi Reverse Gym & Elixir Coffee Jambi: WhatsApp, lokasi di Jl. Nias Kota Baru, jam operasional, dan rute Google Maps untuk konsultasi."
  canonicalPath="/kontak"
  image={business.ogImage}
  breadcrumb={[{ name: 'Kontak', path: '/kontak' }]}
>

  <section class="min-h-[70dvh] border-b b-rule" aria-labelledby="hero">
    <div class="mx-auto grid max-w-[80rem] grid-cols-1 items-center gap-12 px-5 pb-14 pt-12 md:grid-cols-12 md:gap-14 md:px-8 md:py-20">
      <div class="md:col-span-6">
        <nav class="eyebrow" aria-label="Breadcrumb"><a href="/" class="hover:text-fg">Beranda</a> <span aria-hidden="true">/</span> Kontak</nav>
        <h1 id="hero" class="font-display rise mt-4 text-[clamp(2.2rem,6.4vw,4.2rem)] leading-[1.03]" style="--i:1">
          Satu alamat, satu nomor yang diangkat
        </h1>
        <p class="rise mt-6 max-w-[48ch] text-base text-soft" style="--i:2">
          Semua saluran resmi ada di halaman ini. Yang tidak dipublikasikan, kami tidak cantumkan —
          jadi kalau ragu, tanya lewat WhatsApp.
        </p>
        <div class="rise mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2" style="--i:3">
          <a href={waKonsult} class="btn btn-solid" target="_blank" rel="noopener">
            Konsultasi via WhatsApp
          </a>
          <a href={business.mapsUrl} class="btn btn-ghost" target="_blank" rel="noopener">
            Buka rute Google Maps
          </a>
        </div>
      </div>
      <figure class="frame rise aspect-[4/3] rounded-sm border b-rule md:col-span-6" style="--i:2">
        <img src="/images/reverse-5.webp" alt="Ruang kafe Elixir Coffee Kota Baru Jambi" width="720" height="494" loading="eager" fetchpriority="high" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="border-b b-rule py-14 md:py-24" aria-labelledby="info">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <SectionHead
        id="info"
        index="01"
        eyebrow="Info kontak"
        title="Nomor, alamat, dan jam buka"
        lead="Jam gym dan sesi unscheduled dikonfirmasi lewat WhatsApp resmi. Jam Elixir Coffee tercatat di IG resmi."
      />

      <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-4">
          <dl class="rowlist border-t b-rule">
            <div class="py-4">
              <dt class="eyebrow">Alamat</dt>
              <dd class="mt-2 text-sm">{business.address}</dd>
            </div>
            <div class="py-4">
              <dt class="eyebrow">Jam</dt>
              <dd class="mt-2 text-sm">{business.hours}</dd>
            </div>
            <div class="py-4">
              <dt class="eyebrow">WhatsApp</dt>
              <dd class="mt-2 text-sm">0813-7000-780</dd>
            </div>
            <div class="py-4">
              <dt class="eyebrow">Instagram Reverse</dt>
              <dd class="mt-2 text-sm"><a class="text-fg underline decoration-sage/50 underline-offset-4 hover:decoration-accent" href={business.instagram} target="_blank" rel="noopener">@reverse.fitnessindonesia</a></dd>
            </div>
            <div class="py-4">
              <dt class="eyebrow">Instagram Elixir</dt>
              <dd class="mt-2 text-sm"><a class="text-fg underline decoration-sage/50 underline-offset-4 hover:decoration-accent" href={business.elixirInstagram} target="_blank" rel="noopener">@elixir.coffeexperience</a></dd>
            </div>
          </dl>
          <div class="mt-8 grid gap-3">
            <a href={waKontak} class="btn btn-solid w-full" target="_blank" rel="noopener">Tanya via WhatsApp</a>
            <a href={business.mapsUrl} class="btn btn-ghost w-full" target="_blank" rel="noopener">Rute Google Maps</a>
          </div>
        </div>

        <div class="md:col-span-8">
          <MapFacade src={business.mapsEmbed} title="Peta lokasi Reverse Gym & Elixir Coffee, Jl. Nias Kota Baru Jambi" mapsUrl={business.mapsUrl} />
          <p class="mt-4 max-w-[60ch] text-xs text-soft">
            Peta dimuat hanya setelah kamu klik, supaya halaman tetap ringan. Buka rute
            <a class="underline decoration-sage/50 underline-offset-4 hover:decoration-accent" href={business.mapsUrl} target="_blank" rel="noopener">lewat Google Maps</a>
            jika perlu navigasi langsung.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-24" aria-labelledby="cta">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <div class="grid grid-cols-1 gap-6 border-t b-rule pt-10 md:grid-cols-12">
        <h2 id="cta" class="font-display text-[clamp(1.6rem,4vw,2.6rem)] leading-tight md:col-span-7">
          Masih ragu kapan datang? Diskusikan dulu lewat WhatsApp.
        </h2>
        <div class="md:col-span-5">
          <p class="text-sm text-soft">Sebutkan tujuan, riwayat nyeri bila ada, dan waktu realistis — kami bantu tentukan langkah pertama.</p>
          <a href={waKonsult} class="btn btn-solid mt-6 w-full sm:w-auto" target="_blank" rel="noopener">Konsultasi via WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
