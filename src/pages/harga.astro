---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import { business, prices, waLink } from '../data/business';

const waHarga = waLink('Halo Reverse Gym, saya mau konfirmasi tarif keanggotaan dan paket yang tersedia.');
const waBundling = waLink('Halo Reverse Gym & Elixir Coffee, saya mau tanya paket bundling gym + kafe.');

const angkaPrices = prices.filter((p) => p.price.startsWith('Rp'));
const tanyaPrices = prices.filter((p) => !p.price.startsWith('Rp'));
---
<!-- Ref: duality editorial dark earthy — papan harga sebagai list ber-rule bergaya menu, bukan 3 kartu -->
<BaseLayout
  title="Daftar Harga & Paket — Reverse Gym & Elixir Coffee Jambi"
  description="Papan harga Reverse Gym Jambi: sesi harian, bulanan, personal training, fatloss, dan bundling gym+Elixir Coffee. Label jelas: estimasi atau konfirmasi via WA."
  canonicalPath="/harga"
  image={business.ogImage}
  breadcrumb={[{ name: 'Harga', path: '/harga' }]}
>

  <section class="min-h-[70dvh] border-b b-rule" aria-labelledby="hero">
    <div class="mx-auto grid max-w-[80rem] grid-cols-1 items-center gap-12 px-5 pb-14 pt-12 md:grid-cols-12 md:gap-14 md:px-8 md:py-20">
      <div class="md:col-span-6">
        <nav class="eyebrow" aria-label="Breadcrumb"><a href="/" class="hover:text-fg">Beranda</a> <span aria-hidden="true">/</span> Harga</nav>
        <h1 id="hero" class="font-display rise mt-4 text-[clamp(2.2rem,6.4vw,4.2rem)] leading-[1.03]" style="--i:1">
          Harga apa adanya, label sejelas mungkin
        </h1>
        <p class="rise mt-6 max-w-[48ch] text-base text-soft" style="--i:2">
          Angka yang tercantum berlabel <strong class="font-semibold text-sage">Estimasi</strong>.
          Yang belum dipublikasikan ditandai terbuka sebagai butuh konfirmasi — bukan dikarang agar terlihat lengkap.
        </p>
        <a href={waHarga} class="btn btn-solid rise mt-8 w-full sm:w-auto" style="--i:3" target="_blank" rel="noopener">Konfirmasi tarif</a>
      </div>
      <figure class="frame rise aspect-[4/3] rounded-sm border b-rule md:col-span-6" style="--i:2">
        <img src="/images/reverse-2.jpg" alt="Pengukuran lingkar pinggang dengan pita ukur sebagai bagian asesmen komposisi tubuh" width="615" height="410" loading="eager" fetchpriority="high" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="border-b b-rule py-14 md:py-24" aria-labelledby="papan">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <SectionHead
        id="papan"
        index="01"
        eyebrow="Papan harga"
        title="Enam entri, dua tingkat kepastian"
        lead="Kolom kanan setiap baris adalah label data. Jika tertulis estimasi, anggap sebagai titik awal negosiasi informasi, bukan tagihan final."
      />

      <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-14">
        <div class="md:col-span-8">
          <h3 class="eyebrow">Angka estimasi</h3>
          <ul class="rowlist mt-4 border-t b-rule">
            {angkaPrices.map((p) => (
              <li class="py-5">
                <div class="flex flex-wrap items-baseline">
                  <span class="font-display text-xl">{p.name}</span>
                  <span class="leader" aria-hidden="true"></span>
                  <span class="num text-lg font-semibold text-accent">{p.price}</span>
                </div>
                <div class="mt-2 grid grid-cols-1 gap-1 md:grid-cols-[10rem_1fr] md:gap-4">
                  <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sage">{p.badge}</span>
                  <span class="max-w-[56ch] text-sm text-soft">{p.desc}</span>
                </div>
              </li>
            ))}
          </ul>

          <h3 class="eyebrow mt-12">Butuh konfirmasi</h3>
          <ul class="rowlist mt-4 border-t b-rule">
            {tanyaPrices.map((p) => (
              <li class="py-5">
                <div class="flex flex-wrap items-baseline">
                  <span class="font-display text-xl">{p.name}</span>
                  <span class="leader" aria-hidden="true"></span>
                  <span class="text-sm font-semibold text-sage">Tanya via WA</span>
                </div>
                <div class="mt-2 grid grid-cols-1 gap-1 md:grid-cols-[10rem_1fr] md:gap-4">
                  <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sage">{p.badge}</span>
                  <span class="max-w-[56ch] text-sm text-soft">{p.desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <aside class="md:col-span-4" aria-label="Cara membaca harga">
          <div class="border-t b-rule pt-6 md:border-l md:border-t-0 md:pl-8 md:pt-0">
            <h3 class="eyebrow">Cara membaca</h3>
            <dl class="mt-4 grid gap-5 text-sm">
              <div>
                <dt class="font-semibold text-fg">Estimasi</dt>
                <dd class="mt-1 text-soft">Angka perkiraan dari data bisnis. Bisa berbeda dari tarif kasir — konfirmasi dulu.</dd>
              </div>
              <div>
                <dt class="font-semibold text-fg">Klaim IG</dt>
                <dd class="mt-1 text-soft">Layanan yang memang tampil di bio atau sorotan IG resmi, tarifnya belum dipublikasikan.</dd>
              </div>
              <div>
                <dt class="font-semibold text-fg">Bundling gym + kafe</dt>
                <dd class="mt-1 text-soft">Gym dan Elixir Coffee satu lokasi. Pastikan apakah ada paket gabungan saat bertanya.</dd>
              </div>
            </dl>
            <p class="mt-6 text-xs text-soft">
              Tidak ada biaya tersembunyi yang kami klaim. Yang tidak diketahui, kami tulis terbuka.
            </p>
            <a href={waBundling} class="btn btn-ghost mt-6 w-full" target="_blank" rel="noopener">Tanya paket bundling</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-24" aria-labelledby="cta">
    <div class="mx-auto max-w-[80rem] px-5 md:px-8">
      <div class="grid grid-cols-1 gap-6 border-t b-rule pt-10 md:grid-cols-12">
        <h2 id="cta" class="font-display text-[clamp(1.6rem,4vw,2.6rem)] leading-tight md:col-span-7">
          Mau angka final untuk kebutuhanmu?
        </h2>
        <div class="md:col-span-5">
          <p class="text-sm text-soft">Sebutkan tujuan dan berapa hari per minggu yang realistis — admin akan menyebut tarif yang berlaku.</p>
          <a href={waHarga} class="btn btn-solid mt-6 w-full sm:w-auto" target="_blank" rel="noopener">Konfirmasi tarif via WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
