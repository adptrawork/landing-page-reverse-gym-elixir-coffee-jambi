---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, prices, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau konsultasi program fatloss.`);
const gymPrograms = programs.slice(0, 4);
const beans = [
  { name: 'Espresso & Kopi Susu', desc: 'Menu inti Elixir — opsi less sugar pendamping defisit kalori. Varian pasti cek IG Elixir / GrabFood.', tag: 'FAVORIT' },
  { name: 'Kopi Hitam Manual Brew', desc: 'Tanpa gula, pra-latihan yang bersih. Tanya biji yang sedang diseduh ke barista.', tag: 'PRE-WORKOUT' },
  { name: 'Minuman Non-Kopi', desc: 'Opsi untuk yang sensitif kafein atau datang bersama keluarga. Menu pasti cek GrabFood.', tag: 'KELUARGA' },
  { name: 'Pendamping Protein', desc: 'Makanan pendamping latihan — ketersediaan harian tanya langsung di kafe.', tag: 'RECOVERY' },
];
---
<BaseLayout title="Reverse Gym Jambi — Medical Family Gym + Elixir Coffee Kota Baru" description="Reverse Medical & Family Gym Jambi: fatloss specialist, InBody check, physio, personalized program. Satu lokasi dengan Elixir Coffee Jl Nias — konsultasi via WA 0813-7000-780." canonicalPath="/" image={business.ogImage}>
  <!-- INTRO -->
  <section class="max-w-7xl mx-auto px-4 pt-12 pb-6">
    <p class="scan inline-flex items-center gap-2 font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800 border border-teal-800/25 rounded-full px-4 py-1.5 bg-teal-800/[0.05]">
      {business.followers}
    </p>
    <h1 class="scan d1 mt-5 max-w-[20ch] text-4xl md:text-6xl tracking-tighter leading-[0.95] font-bold">Gym berbasis sains, kopi sesudahnya</h1>
    <p class="scan d2 mt-5 text-base text-stone-600 leading-relaxed max-w-[65ch]">Medical &amp; family gym: fatloss specialist, program personal, InBody, physio — satu lokasi dengan Elixir Coffee (GrabFood, buka sampai 22.00/23.00). Gulir: panel gym dan kafe bergerak berlawanan.</p>
    <div class="scan d3 mt-7 flex flex-wrap gap-3">
      <a href={heroCta} class="bg-teal-800 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:bg-teal-900 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Konsultasi Fatloss</a>
      <a href="/program" class="border border-stone-300 px-7 py-3.5 rounded-full font-medium hover:border-teal-800 hover:text-teal-800 active:scale-[0.98]">Lihat Program</a>
    </div>
  </section>

  <!-- SPLIT-SCREEN-SCROLL: gym vs Elixir -->
  <section class="max-w-7xl mx-auto px-4 py-8" aria-label="Dua sisi Reverse">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 split-scroll">
      <div class="split-panel panel-gym rounded-[2.5rem] overflow-hidden bg-teal-900 text-stone-50">
        <img src="/images/reverse-1.jpg" alt="Area beban training center Reverse Gym Jambi" width="800" height="1000" loading="eager" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover opacity-90" />
        <div class="absolute inset-0 bg-gradient-to-t from-teal-950 via-teal-950/55 to-transparent" aria-hidden="true"></div>
        <div class="relative h-full flex flex-col justify-end p-8 md:p-10">
          <p class="font-mono-num text-[11px] tracking-[0.2em] text-teal-200">01 — TRAINING CENTER</p>
          <p class="mt-2 text-2xl md:text-3xl font-bold tracking-tighter">Science-based training &amp; wellness</p>
          <p class="mt-2 text-sm text-stone-200/85 max-w-[45ch]">Personalized program by experts — klaim IG resmi terverifikasi.</p>
        </div>
      </div>
      <div class="split-panel panel-cafe rounded-[2.5rem] overflow-hidden bg-stone-800 text-stone-100 md:mt-24">
        <img src="/images/reverse-5.jpg" alt="Interior Elixir Coffee Kota Baru Jambi" width="800" height="1000" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-90" />
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/55 to-transparent" aria-hidden="true"></div>
        <div class="relative h-full flex flex-col justify-end p-8 md:p-10">
          <p class="font-mono-num text-[11px] tracking-[0.2em] text-stone-300">02 — ELIXIR COFFEE</p>
          <p class="mt-2 text-2xl md:text-3xl font-bold tracking-tighter">Habis latihan, ngopi di Elixir</p>
          <p class="mt-2 text-sm text-stone-200/85 max-w-[45ch]">Jl. Nias Kota Baru — weekday 06.00–22.00, weekend sampai 23.00. Tersedia di GrabFood.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STICKY-STACK PROGRAM -->
  <section class="max-w-7xl mx-auto px-4 py-12" aria-labelledby="program">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <div class="md:col-span-8">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800">Alur program</p>
        <h2 id="program" class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Bertumpuk rapi: ukur, latih, pulih</h2>
      </div>
      <p class="md:col-span-4 text-base text-stone-600"><a class="underline underline-offset-4 font-medium" href="/program">Semua program</a> • <a class="underline underline-offset-4 font-medium" href="/harga">Harga</a></p>
    </div>
    <div class="mt-8 space-y-5">
      {gymPrograms.map((p, i) => (
        <article class={`stack-card scan d${i + 1} rounded-[2.5rem] border overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.08)] ${i % 2 === 0 ? 'bg-white border-stone-200/70' : 'bg-teal-800 text-stone-50 border-teal-800'}`} style={`top:${88 + i * 14}px`}>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-0">
            <img src={p.img} alt={p.alt} width="800" height="500" loading="lazy" class="md:col-span-5 w-full aspect-[16/10] object-cover" />
            <div class="md:col-span-7 p-7 md:p-9">
              <p class={`font-mono-num text-xs ${i % 2 === 0 ? 'text-teal-800' : 'text-teal-200'}`}>0{i + 1} — {p.badge}</p>
              <h3 class="mt-1 font-bold text-xl tracking-tight">{p.name}</h3>
              <p class={`mt-2 text-base ${i % 2 === 0 ? 'text-stone-600' : 'text-stone-200/85'}`}>{p.desc}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- KAFE ACCORDION (stone neutrals only) -->
  <section class="bg-stone-200/40 border-y border-stone-200" aria-labelledby="kafe">
    <div class="max-w-7xl mx-auto px-4 py-14 grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-4">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-stone-500">Elixir Coffee</p>
        <h2 id="kafe" class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Menu kafe, dibuka satu-satu</h2>
        <p class="mt-3 text-base text-stone-600">Menu pasti berubah — cek IG @elixir.coffeexperience atau GrabFood sebelum memesan.</p>
        <img src="/images/reverse-6.jpg" alt="Kopi susu dan minuman protein Elixir Coffee Jambi" width="600" height="450" loading="lazy" class="mt-6 w-full aspect-[4/3] object-cover rounded-[2.5rem]" />
      </div>
      <div class="md:col-span-8 beans">
        {beans.map((b) => (
          <details class="group py-2">
            <summary class="flex items-center gap-4 py-4">
              <span class="bean-plus font-mono-num text-xl text-stone-400" aria-hidden="true">+</span>
              <span class="flex-1 font-bold text-lg tracking-tight">{b.name}</span>
              <span class="font-mono-num text-[10px] tracking-widest border border-stone-400/60 rounded-full px-3 py-1 text-stone-500">{b.tag}</span>
            </summary>
            <div class="bean-body pb-6 pl-9 pr-2 text-base text-stone-600 max-w-[65ch]">{b.desc}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- HARGA RINGKAS -->
  <section class="max-w-7xl mx-auto px-4 py-12" aria-labelledby="harga">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-4">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800">Harga</p>
        <h2 id="harga" class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Mulai dari asesmen</h2>
        <p class="mt-3 text-base text-stone-600">Angka estimasi — konsultasi dulu via WA. <a class="underline underline-offset-4 font-medium text-stone-900" href="/harga">Rincian harga</a></p>
      </div>
      <ol class="md:col-span-8 bg-white border border-stone-200/70 rounded-[2.5rem] divide-y divide-stone-200/80 px-7 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        {prices.slice(0, 4).map((p, i) => (
          <li class="flex items-baseline gap-4 py-5">
            <span class="font-mono-num text-xs text-teal-800 w-7 shrink-0">0{i + 1}</span>
            <p class="flex-1 font-semibold tracking-tight">{p.name}</p>
            <span class="font-mono-num font-semibold text-sm whitespace-nowrap">{p.price}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LOKASI -->
  <section class="max-w-7xl mx-auto px-4 py-12" aria-labelledby="lokasi">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-4">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800">Lokasi</p>
        <h2 id="lokasi" class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Gym + kafe satu lokasi</h2>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">{business.address}. {business.hours}. <a class="underline underline-offset-4 text-stone-900 font-medium" href="/kontak">Hubungi &amp; rute</a></p>
      </div>
      <div class="md:col-span-8">
        <div class="rounded-[2.5rem] overflow-hidden border border-stone-200/70 aspect-video bg-stone-100">
          <iframe title="Peta Reverse Gym Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
