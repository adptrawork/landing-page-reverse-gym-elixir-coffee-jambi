---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, waLink } from '../data/business';
---
<BaseLayout title={`Program ${business.name} — InBody, Fatloss, Physio & Kafe`} description={`Program Reverse Gym Jambi: personalized program, InBody check, fatloss specialist, physio recovery + Elixir Coffee GrabFood.`} canonicalPath="/program">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-sm font-medium text-amber-600">Program</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Recovery • Performance • Longevity</h1>
    <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Tiga pilar sesuai bio IG resmi terverifikasi. Label <strong>Terverifikasi</strong> = ada di bio/highlight IG. <strong>Estimasi</strong> = konfirmasi via WA.</p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {programs.map((p, i) => (
        <article class={i % 2 === 1 ? 'md:mt-10' : ''}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
            <div class="p-7">
              <p class="text-xs font-medium text-amber-600">{p.badge}</p>
              <h2 class="mt-1 font-semibold text-lg">{p.name}</h2>
              <p class="mt-1 text-base text-gray-600">{p.desc}</p>
              <a href={waLink(`Halo ${business.name}, saya mau tanya program ${p.name}.`)} class="mt-4 inline-block bg-zinc-950 text-white px-5 py-2.5 rounded-full text-sm">Tanya via WA</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-8 bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
      <img src="/images/reverse-7.jpg" alt="Opsi makan sehat pendamping program latihan Reverse Gym Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
      <p class="p-5 text-sm text-gray-600">Nutrisi pendamping latihan — foto konteks, ganti foto asli. Sumber: Unsplash (bebas lisensi).</p>
    </div>
    <p class="mt-6 text-xs text-zinc-400">Sumber foto: Unsplash (foto konteks gym/InBody/coaching/sauna/kafe, bebas lisensi) — ganti foto asli.</p>
  </section>
</BaseLayout>
