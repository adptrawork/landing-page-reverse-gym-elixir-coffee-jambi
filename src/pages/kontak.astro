---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, waLink } from '../data/business';
---
<BaseLayout title="Kontak Reverse Gym & Elixir Coffee — WA & Rute Jl Nias" description="Hubungi Reverse Gym via WA 0813-7000-780. Elixir Coffee Jl Nias Kota Baru: weekday 06.00–22.00, weekend 06.00–23.00. Rute via Google Maps." canonicalPath="/kontak">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800">Kontak</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Mulai dari obrolan WA</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Ceritakan targetmu (fatloss/performance/recovery) — tim akan mengarahkan ke InBody atau konsultasi dulu.</p>
        <div class="mt-8 bg-white border border-stone-200/70 rounded-[2.5rem] p-8 space-y-4">
          <div><label for="nama" class="text-sm font-medium">Nama</label><input id="nama" placeholder="Nama kamu" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-stone-50" /></div>
          <div><label for="tujuan" class="text-sm font-medium">Keperluan</label><select id="tujuan" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-stone-50"><option>Konsultasi fatloss</option><option>InBody check</option><option>Tanya physio / recovery</option><option>Tanya Elixir Coffee</option></select></div>
          <div class="flex flex-wrap gap-3">
            <button id="copy" class="bg-teal-800 text-white px-7 py-3.5 rounded-full font-medium active:scale-[0.98]">Salin &amp; Kirim WA</button>
            <a href={business.elixirInstagram} class="border border-stone-300 px-7 py-3.5 rounded-full font-medium hover:border-teal-800 hover:text-teal-800">IG Elixir Coffee</a>
          </div>
          <p id="ok" class="hidden text-sm text-teal-800">Tersalin — tempel di WA 0813-7000-780.</p>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-stone-200/70 rounded-[2.5rem] overflow-hidden">
          <img src="/images/reverse-5.jpg" alt="Interior Elixir Coffee Kota Baru Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-8">
            <p class="font-bold">Info kunjungan</p>
            <p class="mt-2 text-sm text-stone-600">{business.address}</p>
            <p class="mt-1 text-sm text-stone-600">{business.hours}</p>
            <p class="mt-1 font-mono-num text-sm text-teal-800">WA 0813-7000-780</p>
            <a class="mt-4 inline-block underline underline-offset-4" href={business.mapsUrl}>Rute ke lokasi</a>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-8 rounded-[2.5rem] overflow-hidden border border-stone-200/70 aspect-video bg-stone-100">
      <iframe title="Peta Reverse Gym Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
    </div>
  </section>
<script is:inline>
document.getElementById('copy').addEventListener('click', function() {
  var nama = (document.getElementById('nama').value || '').trim() || '[nama]';
  var tujuan = document.getElementById('tujuan').value;
  var msg = 'Halo Reverse Gym, saya ' + nama + '. Mau ' + tujuan + '. Kapan bisa dijadwalkan?';
  navigator.clipboard.writeText(msg).then(function() {
    document.getElementById('ok').classList.remove('hidden');
    window.open('https://wa.me/628137000780?text=' + encodeURIComponent(msg), '_blank');
  });
});
</script>
</BaseLayout>
