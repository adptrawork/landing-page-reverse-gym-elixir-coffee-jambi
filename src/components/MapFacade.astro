---
interface Props { src: string; title: string; mapsUrl: string; label?: string }
const { src, title, mapsUrl, label = 'Muat peta & buka rute' } = Astro.props;
---
<!-- Maps facade: iframe disuntik hanya saat diklik (hemat ~7MB JS Google Maps) -->
<div
  class="map-facade frame relative aspect-[4/3] w-full rounded-sm border b-rule md:aspect-video"
  data-src={src}
  data-title={title}
>
  <div class="absolute inset-0 grid place-items-center" aria-hidden="true">
    <svg class="h-16 w-16 text-sage/70" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M24 43s13-11.4 13-21A13 13 0 0 0 11 22c0 9.6 13 21 13 21Z" />
      <circle cx="24" cy="21.5" r="4.8" />
    </svg>
  </div>
  <a href={mapsUrl} class="absolute inset-0 grid place-items-center" data-map-link target="_blank" rel="noopener">
    <span class="btn btn-fg">{label}</span>
  </a>
</div>
<script is:inline>
(function () {
  function init(scope) {
    (scope || document).querySelectorAll('.map-facade').forEach(function (el) {
      if (el.dataset.done) return; el.dataset.done = '1';
      el.querySelector('[data-map-link]').addEventListener('click', function (ev) {
        ev.preventDefault();
        var f = document.createElement('iframe');
        f.title = el.dataset.title || 'Peta lokasi';
        f.src = el.dataset.src; f.loading = 'lazy';
        f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
        el.appendChild(f); el.querySelector('[data-map-link]').remove();
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); });
  else init(document);
})();
</script>
