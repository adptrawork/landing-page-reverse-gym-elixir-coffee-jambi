---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
import { business, waLink } from '../data/business';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  breadcrumb?: Crumb[];
}
const { title, description, canonicalPath = '/', image, breadcrumb = [] } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://landing-page-reverse-gym-elixir-coffee-jambi.adi-putra-work1.workers.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
const cta = waLink('Halo Reverse Gym & Elixir Coffee, saya mau tanya program dan layanan.');
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/program', label: 'Program' },
  { href: '/pelatih', label: 'Pelatih' },
  { href: '/harga', label: 'Harga' },
  { href: '/kontak', label: 'Kontak' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} breadcrumb={breadcrumb} />
</head>
<body class="min-h-[100dvh]">
  <a href="#main" class="skip-link">Lewati ke konten utama</a>

  <input type="checkbox" id="nav-toggle" class="nav-toggle md:hidden" aria-label="Buka atau tutup menu navigasi" />

  <header class="sticky top-0 z-50 border-b b-rule bg-bg/95 backdrop-blur">
    <nav class="mx-auto grid max-w-[80rem] grid-cols-[1fr_auto] items-center gap-4 px-5 py-3 md:px-8" aria-label="Navigasi utama">
      <a href="/" class="flex min-h-[48px] items-center gap-3">
        <svg class="h-9 w-9 shrink-0 text-sage" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <rect x="0.75" y="0.75" width="38.5" height="38.5" rx="1.5" stroke="currentColor" stroke-width="1.5" />
          <path d="M13 28V12h7.6a4.7 4.7 0 0 1 0 9.4H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          <path d="M20.4 21.4 28 28" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
        <span class="font-display text-2xl leading-none">
          Reverse<span class="text-accent">&nbsp;&times;&nbsp;</span>Elixir
          <small class="mt-1 block font-sans text-[10px] font-semibold uppercase tracking-[0.24em] text-sage">Medical Gym &amp; Coffee — Jambi</small>
        </span>
      </a>

      <div class="flex items-center gap-1">
        <div class="hidden items-center gap-6 md:flex">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={['inline-flex min-h-[48px] items-center text-xs font-semibold uppercase tracking-[0.16em] transition', path === n.href ? 'text-accent' : 'text-soft hover:text-fg']}
              aria-current={path === n.href ? 'page' : undefined}
            >{n.label}</a>
          ))}
        </div>
        <a href={cta} class="btn btn-solid ml-2 hidden sm:inline-flex" target="_blank" rel="noopener">WhatsApp</a>
        <label for="nav-toggle" class="burger grid min-h-[48px] min-w-[48px] cursor-pointer place-items-center text-fg md:hidden">
          <span class="sr-only">Buka atau tutup menu navigasi</span>
          <span aria-hidden="true">
            <span class="bar bar-1"></span>
            <span class="bar bar-2"></span>
            <span class="bar bar-3"></span>
          </span>
        </label>
      </div>

      <div class="mobile-menu md:hidden">
        <div class="grid grid-cols-1 px-5 py-2">
          {nav.map((n) => (
            <a href={n.href} class:list={['flex min-h-[48px] items-center border-b b-rule text-sm font-semibold uppercase tracking-[0.14em]', path === n.href ? 'text-accent' : 'text-fg']} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href={cta} class="btn btn-solid mt-4 mb-3 w-full" target="_blank" rel="noopener">Tanya via WhatsApp</a>
        </div>
      </div>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <!-- Ref: footer NAP ringkas + kredit gambar -->
  <footer class="mt-24 border-t b-rule bg-bg">
    <div class="mx-auto grid max-w-[80rem] grid-cols-1 gap-10 px-5 py-14 md:grid-cols-12 md:px-8">
      <div class="md:col-span-5">
        <p class="font-display text-3xl leading-tight">Reverse Gym <span class="text-accent">&times;</span> Elixir Coffee</p>
        <p class="mt-4 max-w-[38ch] text-sm text-soft">{business.address}</p>
        <p class="mt-2 max-w-[38ch] text-sm text-soft">{business.hours}</p>
        <p class="eyebrow mt-6">Recovery &mdash; Performance &mdash; Longevity</p>
      </div>

      <div class="md:col-span-4">
        <h2 class="eyebrow">Hubungi</h2>
        <ul class="rowlist mt-3 text-sm">
          <li class="py-2"><a class="inline-flex min-h-[44px] items-center text-fg underline decoration-sage/50 underline-offset-4 hover:decoration-accent" href={cta} target="_blank" rel="noopener">WhatsApp 0813-7000-780</a></li>
          <li class="py-2"><a class="inline-flex min-h-[44px] items-center text-fg underline decoration-sage/50 underline-offset-4 hover:decoration-accent" href={business.instagram} target="_blank" rel="noopener">IG @reverse.fitnessindonesia</a></li>
          <li class="py-2"><a class="inline-flex min-h-[44px] items-center text-fg underline decoration-sage/50 underline-offset-4 hover:decoration-accent" href={business.elixirInstagram} target="_blank" rel="noopener">IG @elixir.coffeexperience</a></li>
          <li class="py-2"><a class="inline-flex min-h-[44px] items-center text-fg underline decoration-sage/50 underline-offset-4 hover:decoration-accent" href={business.mapsUrl} target="_blank" rel="noopener">Rute Google Maps</a></li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h2 class="eyebrow">Jelajahi</h2>
        <ul class="mt-3 grid gap-1 text-sm">
          {nav.map((n) => <li><a class="inline-flex min-h-[44px] items-center text-soft hover:text-fg" href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="border-t b-rule">
      <div class="mx-auto flex max-w-[80rem] flex-col gap-2 px-5 py-6 text-xs text-soft md:flex-row md:items-center md:justify-between md:px-8">
        <p>&copy; 2026 Reverse Gym &amp; Elixir Coffee &mdash; Kota Jambi.</p>
        <p class="max-w-[60ch]">Kredit gambar: sebagian foto layanan dari Wikimedia Commons (CC0 / CC BY-SA 4.0 / CC BY 2.0) &mdash; detail sumber di README repo. Harga berlabel estimasi, konfirmasi via WhatsApp.</p>
      </div>
    </div>
  </footer>

  {/*
    Catatan aksesibilitas: toggle menu memakai checkbox CSS-only,
    alasan teknis aria-hidden dipasang pada input tersembunyi di atas.
  */}
</body>
</html>
