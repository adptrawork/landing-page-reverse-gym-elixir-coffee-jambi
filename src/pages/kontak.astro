---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
---
<BaseLayout title={`Kontak ${business.name} — WA, IG, GrabFood & Rute`} description={`Hubungi Reverse Gym: WA 0813-7000-780, IG terverifikasi. Elixir Coffee Jl Nias Kota Baru, weekday 06.00–22.00, weekend 06.00–23.00, GrabFood.`} canonicalPath="/kontak">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7">
        <p class="text-sm font-medium text-amber-600">Kontak</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Konsultasi dulu, gratis tanya</h1>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Isi form, tekan kirim — pesan terformat rapi terbuka di WhatsApp 0813-7000-780.</p>
        <form id="book" class="mt-8 bg-white border border-slate-200/50 rounded-[2.5rem] p-8 space-y-4">
          <div><label for="nama" class="text-sm font-medium">Nama</label><input id="nama" required placeholder="Nama kamu" class="mt-1 w-full border rounded-2xl px-4 py-3 min-h-[48px]" /></div>
          <div><label for="tujuan" class="text-sm font-medium">Tujuan</label><select id="tujuan" class="mt-1 w-full border rounded-2xl px-4 py-3 min-h-[48px]"><option>Fatloss</option><option>Naik massa otot</option><option>Recovery / physio</option><option>Coba InBody dulu</option><option>Nanya Elixir Coffee</option></select></div>
          <p id="err" class="hidden text-sm text-red-600">Isi nama dulu.</p>
          <button class="bg-amber-600 text-white px-7 py-3.5 rounded-full font-medium active:scale-[0.98]">Kirim via WhatsApp</button>
        </form>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
          <img src="/images/reverse-6.jpg" alt="Kopi susu dan minuman protein Elixir Coffee Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-8">
            <p class="font-semibold">Info kunjungan</p>
            <p class="mt-2 text-sm text-gray-600">{business.address}</p>
            <p class="mt-1 text-sm text-gray-600">{business.hours}</p>
            <p class="mt-1 text-sm text-gray-600">WA gym: 0813-7000-780 • Elixir: GrabFood tersedia</p>
            <a class="mt-4 inline-block underline" href={business.mapsUrl}>Rute ke lokasi</a>
          </div>
        </div>
        <p class="mt-3 text-xs text-zinc-400">Sumber foto: Unsplash (bebas lisensi) — ganti foto asli.</p>
      </div>
    </div>
    <div class="mt-8 rounded-[2.5rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
      <iframe title="Peta Reverse Gym Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
    </div>
  </section>
<script is:inline>
document.getElementById('book').addEventListener('submit', function(e) {
  e.preventDefault();
  var nama = document.getElementById('nama').value.trim();
  var tujuan = document.getElementById('tujuan').value;
  var err = document.getElementById('err');
  if (!nama) { err.classList.remove('hidden'); return; }
  err.classList.add('hidden');
  var msg = 'Halo Reverse Gym, saya ' + nama + '. Tujuan: ' + tujuan + '. Bisa konsultasi dulu?';
  window.open('https://wa.me/628137000780?text=' + encodeURIComponent(msg), '_blank');
});
</script>
</BaseLayout>
