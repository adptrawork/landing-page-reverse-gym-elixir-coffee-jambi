---
interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  image?: string;
  breadcrumb?: Crumb[];
}
const { title, description, canonicalUrl, image = '/images/reverse-1.jpg', breadcrumb = [] } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://landing-page-reverse-gym-elixir-coffee-jambi.adi-putra-work1.workers.dev').replace(/\/$/, '');
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();

// JSON-LD LocalBusiness (ExerciseGym adalah subtipe LocalBusiness) — hanya data terverifikasi.
const localBusiness = {
  "@context": "https://schema.org",
  "@type": ["ExerciseGym", "LocalBusiness"],
  "@id": `${site}/#business`,
  name: "Reverse Gym & Elixir Coffee",
  url: `${site}/`,
  image: ogImage,
  description: description,
  telephone: "+628137000780",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jl. Nias, Kota Baru",
    addressLocality: "Kota Jambi",
    addressRegion: "Jambi",
    addressCountry: "ID"
  },
  sameAs: [
    "https://www.instagram.com/reverse.fitnessindonesia",
    "https://www.instagram.com/elixir.coffeexperience"
  ],
  exerciseType: ["Physiotherapy", "Nutrition"]
};

// BreadcrumbList — selalu diawali Beranda.
const trails: Crumb[] = [{ name: 'Beranda', path: '/' }, ...breadcrumb];
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trails.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: `${site}${c.path}`
  }))
};

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Apa itu Reverse Medical & Family Gym di Jambi?",
      acceptedAnswer: { "@type": "Answer", text: "Reverse adalah medical & family gym dengan tiga pilar Recovery, Performance, dan Longevity. Layanan terverifikasi dari IG resmi @reverse.fitnessindonesia meliputi InBody check, fatloss specialist, personalized program, dan physio." }
    },
    {
      "@type": "Question",
      name: "Di mana lokasi Elixir Coffee dan jam bukanya?",
      acceptedAnswer: { "@type": "Answer", text: "Elixir Coffee di Jl. Nias, Kota Baru, Jambi. Buka weekday 06.00–22.00 dan weekend 06.00–23.00, tersedia juga di GrabFood." }
    },
    {
      "@type": "Question",
      name: "Bagaimana cara konsultasi program fatloss di Reverse Gym?",
      acceptedAnswer: { "@type": "Answer", text: "Konsultasi via WhatsApp 0813-7000-780 (tombol WA dari bio IG resmi). Diawali InBody check lalu disusun personalized program oleh coach dan physio." }
    },
    {
      "@type": "Question",
      name: "Apakah harga di situs ini sudah pasti?",
      acceptedAnswer: { "@type": "Answer", text: "Harga gym di situs ini berlabel estimasi. Tarif akhir dan paket bundling Gym + Elixir dikonfirmasi via WhatsApp sebelum pembayaran." }
    }
  ]
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Italiana&display=swap" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Italiana&display=swap" /></noscript>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#201C18" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content="Reverse Gym & Elixir Coffee — Recovery, Performance, Longevity" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="Rak dumbel training center Reverse Gym dan interior Elixir Coffee Jambi" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faq)} />
