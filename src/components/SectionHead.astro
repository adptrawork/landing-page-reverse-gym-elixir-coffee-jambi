---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  index?: string;
  lead?: string;
}
const { id, eyebrow, title, index, lead } = Astro.props;
---
<!-- Ref: duality editorial — kepala seksi asimetris (label + rule + lead) -->
<header class="grid grid-cols-1 gap-5 md:grid-cols-12 md:items-end md:gap-8">
  <div class="md:col-span-7">
    <p class="eyebrow flex items-center gap-3">
      {index && <span class="num text-accent">{index}</span>}
      <span>{eyebrow}</span>
      <span class="hidden h-px w-16 shrink-0 bg-sage/40 sm:block" aria-hidden="true"></span>
    </p>
    <h2 id={id} class="font-display mt-3 text-[clamp(1.9rem,4.6vw,3.15rem)] leading-[1.06]">{title}</h2>
  </div>
  {lead && <p class="max-w-[46ch] text-sm text-soft md:col-span-5 md:text-base">{lead}</p>}
</header>
