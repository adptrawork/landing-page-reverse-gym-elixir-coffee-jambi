---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, waLink } from '../data/business';
const gymOnly = programs.slice(0, 4);
---
<BaseLayout title="Program Reverse Gym Jambi — InBody, Fatloss & Physio" description="Program Reverse Gym: InBody check, fatloss specialist, personalized program, physio recovery. Klaim terverifikasi IG @reverse.fitnessindonesia — konsultasi via WA." canonicalPath="/program">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-teal-800">Program gym</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold max-w-[20ch]">Ukur dulu, baru latihan</h1>
    <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Label <strong>Terverifikasi</strong> = klaim bio/highlight IG resmi.</p>
    <div class="mt-10 space-y-5">
      {gymOnly.map((p, i) => (
        <article class={`stack-card rounded-[2.5rem] border overflow-hidden ${i % 2 === 0 ? 'bg-white border-stone-200/70' : 'bg-teal-800 text-stone-50 border-teal-800'}`} style={`top:${88 + i * 14}px`}>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-0">
            <img src={p.img} alt={p.alt} width="800" height="500" loading="lazy" class="md:col-span-5 w-full aspect-[16/10] object-cover" />
            <div class="md:col-span-7 p-7 md:p-9">
              <p class={`font-mono-num text-xs ${i % 2 === 0 ? 'text-teal-800' : 'text-teal-200'}`}>0{i + 1} — {p.badge}</p>
              <h2 class="mt-1 font-bold text-xl tracking-tight">{p.name}</h2>
              <p class={`mt-2 text-base ${i % 2 === 0 ? 'text-stone-600' : 'text-stone-200/85'}`}>{p.desc}</p>
              <a href={waLink(`Halo ${business.name}, saya mau tanya program ${p.name}.`)} class={`mt-4 inline-block px-5 py-2.5 rounded-full text-sm font-medium active:scale-[0.98] ${i % 2 === 0 ? 'bg-stone-900 text-white' : 'bg-stone-50 text-teal-900'}`}>Tanya via WA</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="bg-stone-200/40 border-y border-stone-200" aria-label="Sisi kafe">
    <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <p class="font-mono-num text-[11px] tracking-[0.2em] uppercase text-stone-500">Elixir Coffee</p>
        <h2 class="mt-2 text-3xl tracking-tighter font-bold">Sisi kafe: kopi &amp; nongkrong sehat</h2>
        <p class="mt-2 text-base text-stone-600 max-w-[65ch]">Weekday 06.00–22.00, weekend 06.00–23.00. Tersedia di GrabFood — {business.address}.</p>
      </div>
      <div class="md:col-span-5">
        <img src="/images/reverse-5.jpg" alt="Interior Elixir Coffee Kota Baru Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[4/3] object-cover rounded-[2.5rem]" />
      </div>
    </div>
  </section>
</BaseLayout>
